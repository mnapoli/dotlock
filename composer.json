{
    "name": "mnapoli/dotlock",
    "description": "Secure secrets for local Laravel development",
    "keywords": ["laravel", "dotenv", "env", "secrets", "encryption", "credentials"],
    "license": "MIT",
    "authors": [
        {
            "name": "Matthieu Napoli",
            "email": "matthieu@mnapoli.fr"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/mnapoli"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-sodium": "*",
        "laravel/framework": "^13.0",
        "laravel/prompts": "^0.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.1|^5.0",
        "pestphp/pest-plugin-rector": "^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0|^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Dotlock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dotlock\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dotlock\\DotlockServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector",
            "rector -c rector-tests.php"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "rector -c rector-tests.php --dry-run"
        ],
        "test:types": "phpstan",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:coverage": "pest --coverage --min=85",
        "test:unit": "pest",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit",
            "@test:coverage"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
